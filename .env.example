# Supabase (auth + storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Guest mode ("Probar sin cuenta") requires in Supabase Dashboard (Authentication → Sign In / Providers):
# - Allow anonymous sign-ins → ON + Save
# - Allow manual linking → ON + Save (needed for "Crear cuenta" from guest mode)
# Set NEXT_PUBLIC_GUEST_MODE_ENABLED="false" to hide the guest CTA.
NEXT_PUBLIC_SUPABASE_AVATAR_BUCKET="Avatar-profiles"
NEXT_PUBLIC_SUPABASE_MEAL_PHOTO_BUCKET="meal-logs-photos"
NEXT_PUBLIC_SUPABASE_RECIPE_COVER_BUCKET="recipe-covers"

# NestJS backend API (must be NEXT_PUBLIC_* — called from client components)
NEXT_PUBLIC_BACKEND_API_URL="http://localhost:3000"

# Frontend app URL (OAuth redirects; optional — falls back to window.location.origin)
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3001"

# Opcional: fijar fecha en home para pruebas (YYYY-MM-DD)
# NEXT_PUBLIC_HOME_DEBUG_DATE="2026-06-24"

# Máximo de intentos al resolver URLs privadas de imágenes (signed URLs)
NEXT_PUBLIC_MEDIA_URL_MAX_ATTEMPTS=2
